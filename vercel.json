{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/projects/save", "destination": "/api/projects?operation=save" },
    { "source": "/api/projects/delete", "destination": "/api/projects?operation=delete" },
    { "source": "/site/:slug", "destination": "/public-site.html?slug=:slug" }
  ]
}
