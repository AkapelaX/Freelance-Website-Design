# Supabase public configuration (safe for /api/config response)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Supabase server-only key. NEVER place this in index.html or browser JavaScript.
# Use your service_role key or the new Supabase secret key.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_KEY

# Stripe server-only configuration (can remain placeholders during Auth + Cloud Draft testing)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STARTER_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_ADVANCED_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_STARTER_BUYOUT=price_REPLACE_ME
STRIPE_PRICE_PROFESSIONAL_BUYOUT=price_REPLACE_ME
STRIPE_PRICE_ADVANCED_BUYOUT=price_REPLACE_ME
